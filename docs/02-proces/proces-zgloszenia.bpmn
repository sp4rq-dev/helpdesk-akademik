<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Helpdesk" targetNamespace="http://helpdesk-akademik/bpmn" exporter="helpdesk-akademik" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Helpdesk">
    <bpmn:participant id="Pool_Helpdesk" name="Helpdesk Akademika – obsługa sprawy mieszkańca" processRef="Proc_Zgloszenie" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Zgloszenie" name="Obsługa sprawy mieszkańca" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_M" name="Mieszkaniec">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_B" name="Asystent AI (bot)">
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_R" name="Recepcja">
        <bpmn:flowNodeRef>R0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_R1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_K" name="Konserwator">
        <bpmn:flowNodeRef>J2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>K2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_D" name="Kierownik akademika">
        <bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Wystąpił problem lub pytanie">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="M1" name="Opisz sprawę w czacie (tekst, zdjęcie)">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="M2" name="Zapoznaj się z odpowiedzią">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_M1" name="Sprawa rozwiązana?">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Sprawa zamknięta bez zgłoszenia">
      <bpmn:incoming>F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="M3" name="Sprawdź wykonaną naprawę">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_M2" name="Naprawa skuteczna?">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="M4" name="Oceń obsługę (1–5)">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E2" name="Zgłoszenie zamknięte">
      <bpmn:incoming>F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="B1" name="Sklasyfikuj sprawę (LLM)">
      <bpmn:documentation>Model językowy rozpoznaje intencję: pytanie informacyjne, usterka albo awaria krytyczna (zalanie, brak prądu, gaz).</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_B1" name="Rodzaj sprawy?">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B2" name="Odpowiedz na podstawie regulaminu i FAQ (RAG)">
      <bpmn:documentation>Odpowiedź generowana wyłącznie na podstawie dokumentów akademika, ze wskazaniem źródła.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="B4" name="Wyślij alarm do recepcji + instrukcję dla mieszkańca">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="J0">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="B3" name="Utwórz zgłoszenie (kategoria, priorytet)">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="R0" name="Podejmij interwencję doraźną">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="R1" name="Zweryfikuj zgłoszenie">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_R1" name="Zgłoszenie zasadne?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="R2" name="Odrzuć i poinformuj mieszkańca">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E3" name="Zgłoszenie odrzucone">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J1">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="R3" name="Przydziel konserwatora i termin (SLA)">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J2">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="K1" name="Wykonaj naprawę">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="K2" name="Zgłoś zakończenie prac">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="D1" name="Eskaluj: zmień wykonawcę lub priorytet">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="T1" name="Przekroczony termin SLA" attachedToRef="K1">
      <bpmn:documentation>Wyjątek: termin realizacji minął przed zgłoszeniem zakończenia prac. Przerywa zadanie i eskaluje sprawę do kierownika.</bpmn:documentation>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_SLA" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="S1" targetRef="M1" />
    <bpmn:sequenceFlow id="F02" sourceRef="M1" targetRef="B1" />
    <bpmn:sequenceFlow id="F03" sourceRef="B1" targetRef="G_B1" />
    <bpmn:sequenceFlow id="F04" name="pytanie informacyjne" sourceRef="G_B1" targetRef="B2" />
    <bpmn:sequenceFlow id="F05" name="usterka" sourceRef="G_B1" targetRef="J0" />
    <bpmn:sequenceFlow id="F06" name="awaria krytyczna" sourceRef="G_B1" targetRef="B4" />
    <bpmn:sequenceFlow id="F07" sourceRef="B2" targetRef="M2" />
    <bpmn:sequenceFlow id="F08" sourceRef="M2" targetRef="G_M1" />
    <bpmn:sequenceFlow id="F09" name="tak" sourceRef="G_M1" targetRef="E1" />
