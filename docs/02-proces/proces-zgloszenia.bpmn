    <bpmn:sequenceFlow id="F22" sourceRef="K1" targetRef="K2" />
    <bpmn:sequenceFlow id="F23" sourceRef="K2" targetRef="M3" />
    <bpmn:sequenceFlow id="F24" sourceRef="M3" targetRef="G_M2" />
    <bpmn:sequenceFlow id="F25" name="tak" sourceRef="G_M2" targetRef="M4" />
    <bpmn:sequenceFlow id="F26" sourceRef="M4" targetRef="E2" />
    <bpmn:sequenceFlow id="F27" name="nie" sourceRef="G_M2" targetRef="J2" />
    <bpmn:sequenceFlow id="F28" sourceRef="T1" targetRef="D1" />
    <bpmn:sequenceFlow id="F29" sourceRef="D1" targetRef="J2" />
  </bpmn:process>
